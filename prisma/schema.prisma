generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

// --- USUARIOS ---
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  username    String    // Equivalente a 'name'
  isSuperuser Boolean   @default(false)
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  

  comments    Comment[]
  
  createdAt   DateTime  @default(now())
}

// --- BLOG/NOTICIAS ---
model ArticleTopic {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[]
}

model Article {
  id        String   @id @default(cuid())
  name      String   // Título display
  info      String?  // Breve descripción
  slug      String   @unique  // Identificador único para URLs (ej: "pasado", "presente")
  
  topicId   Int
  topic     ArticleTopic @relation(fields: [topicId], references: [id])
  
  comments  Comment[]
  
  createdAt DateTime @default(now())
}

model Comment {
  id          String   @id @default(cuid())
  textComment String // SQLite no soporta VARCHAR(N), validaremos longitud en código (500 chars)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id])
  
  createdAt   DateTime @default(now())

  // Restricción: Un usuario solo puede tener un comentario por artículo
  @@unique([userId, articleId])
}
